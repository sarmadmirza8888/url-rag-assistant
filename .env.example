# Copy this file to .env and fill in your own values. NEVER commit .env.

# PostgreSQL with the pgvector extension (Neon, Supabase, local, ...)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Path to a 4-bit Mistral 7B Instruct model (local folder or Kaggle dataset)
MODEL_PATH=/path/to/mistral-7b-instruct-4bit

# Optional: embedding model (default shown)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Sent in the User-Agent so sites like Wikipedia can contact you (their policy asks for this)
CONTACT_EMAIL=you@example.com
PROJECT_URL=https://github.com/your-username/url-rag-assistant

# Set to 1 to get a temporary public Gradio link
GRADIO_SHARE=0
